{
    "name": "jira-bot",
    "version": "1.0.0",
    "description": "A Discord bot designed to report JIRA project updates",
    "main": "src/bot/index.js",
    "scripts": {
        "start:bot": "node src/bot/index.js",
        "start:api": "node src/api/index.js",
        "start": "concurrently \"npm run start:bot\" \"npm run start:api\"",
        "dev": "concurrently -n BOT,API \"nodemon --watch src/bot src/bot/index.js\" \"nodemon --watch src/api src/api/index.js\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LJMU-SE/jira-bot.git"
    },
    "author": "Ollie Beenham",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/LJMU-SE/jira-bot/issues"
    },
    "homepage": "https://github.com/LJMU-SE/jira-bot#readme",
    "dependencies": {
        "discord.js": "^14.14.1",
        "dotenv": "^16.4.1",
        "express": "^4.19.2",
        "sqlite3": "^5.1.7"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "nodemon": "^3.0.3"
    },
    "imports": {
        "#*": "./src/*"
    }
}
